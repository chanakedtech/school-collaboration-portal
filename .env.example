# ── Backend ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local (SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Docker (PostgreSQL) — used automatically by docker-compose.yml
# DATABASE_URL is set by docker-compose from the POSTGRES_* vars below

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── PostgreSQL (Docker only) ────────────────────────────────────────────────────
POSTGRES_DB=school_portal
POSTGRES_USER=portal
POSTGRES_PASSWORD=portal_pass

# ── Frontend ───────────────────────────────────────────────────────────────────
# Local
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Docker — change to http://localhost:8000/api in frontend/.env when using Docker
# VITE_API_BASE_URL=http://localhost:8000/api
